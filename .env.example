# Google Gemini API Key (Required for Multimodal VLM Satellite Analysis)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API Key (Recommended for real-time ground-truth geospatial search)
# Obtain from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Groq API Key (Optional fallback text inference)
# Obtain from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
